# Production backend base URL (Vercel). The API client appends /api automatically.
REACT_APP_API_URL=https://orbit.gamer.gd/backend

# For local development, use your local backend URL instead, for example:
# REACT_APP_API_URL=http://localhost/orbit-api

# Optional router base path. Keep empty when deployed at the domain root.
REACT_APP_BASENAME=
